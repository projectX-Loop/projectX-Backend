# Copy to /etc/projectx/backend.env on the OCI VM. Do not commit that file.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_SECRET=replace-with-a-long-random-value

POSTGRES_DB=projectx
POSTGRES_USER=projectx
POSTGRES_PASSWORD=replace-with-a-long-random-password
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/projectx
SPRING_DATASOURCE_USERNAME=projectx
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-password

CLOUDFRONT_ORIGIN_SECRET=replace-with-a-long-random-value
GEMINI_API_KEY=replace-with-a-restricted-gemini-api-key
GEMINI_GENERATION_MODEL=choose-and-pin-a-generation-model
GEMINI_EMBEDDING_MODEL=choose-and-pin-an-embedding-model
RAG_EMBEDDING_DIMENSIONS=replace-with-the-embedding-model-dimension
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_DOCUMENT_ROOT=/opt/projectx/documents

AWS_S3_BUCKET=replace-with-frontend-bucket-name
AWS_CLOUDFRONT_DISTRIBUTION_ID=replace-with-distribution-id
OCI_HOST=replace-with-oci-public-ip-or-hostname
OCI_USER=ubuntu
OCI_SSH_KEY=/absolute/path/to/oci-ssh-private-key
